<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The repository restores from nuget.org only, whatever a developer's own configuration says. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
