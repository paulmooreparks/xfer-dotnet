<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ParksComputing.XferLang</PackageId>
    <Description>XferLang 1.0 for .NET: a data format with no escape sequences, typed values and line-independent syntax. Parser, lossless syntax tree, canonical writer, JSON mapping and object mapper.</Description>
    <PackageTags>xferlang;xfer;data-format;parser;serialization;json;configuration</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
    <EnablePackageValidation>true</EnablePackageValidation>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CA1720: the kinds of an XferLang value really are called String, Integer and so on. -->
    <!-- CA1710: XferObject is a dictionary but is named for what it is in the language. RS0026: the
         entry points take the input in several types and options last, as System.Text.Json does. -->
    <NoWarn>$(NoWarn);CA1720;CA1710;RS0026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="ParksComputing.XferLang.Tests" />
  </ItemGroup>

</Project>
