<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test code is not part of the public surface and need not carry documentation. -->
    <NoWarn>$(NoWarn);CS1591;CA1861;CA1859;CA1805</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FsCheck.Xunit.v3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="ParksComputing.Xfer.Lang" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="expected-failures.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ParksComputing.XferLang/ParksComputing.XferLang.csproj" />
  </ItemGroup>

</Project>
